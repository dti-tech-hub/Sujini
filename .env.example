# ---------------------------------------------------------------------------
# AI Cyber Incident Response - environment template
# Copy to .env and fill in what you have. NEVER commit .env.
# ---------------------------------------------------------------------------

APP_ENV=development
DEMO_MODE=true
DATABASE_URL=sqlite:///data/soc.db

# Secret used to sign JWTs. Leave empty and the app generates
# data/.secret_key (random, local, git-ignored) on first start.
SOC_SECRET_KEY=

# Demo/seed account passwords. seed_database.py generates random values and
# writes them to data/demo_credentials.json when these are empty.
SOC_ADMIN_USERNAME=admin
SOC_ADMIN_PASSWORD=
SOC_ANALYST_USERNAME=analyst
SOC_ANALYST_PASSWORD=
SOC_VIEWER_USERNAME=viewer
SOC_VIEWER_PASSWORD=

# Threat intelligence (optional). Without keys the MockProvider is used and
# every result is explicitly marked DEMO / MOCK.
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
THREAT_INTEL_ALLOW_MOCK_FALLBACK=true

# Optional OpenAI-compatible LLM endpoint (OpenAI, Azure-compatible gateway,
# Ollama with /v1, vLLM, etc.). Without configuration the system runs the
# deterministic template provider and clearly labels LLM: DEMO MODE.
LLM_ENABLED=false
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=25

# API / dashboard
API_BASE_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
